generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String        @id @default(cuid())
  name          String
  username      String        @unique
  emailVerified DateTime?
  image         String?
  password      String
  phone         String?
  storeId       BigInt?       @map("store_id")
  isActive      Boolean       @default(true) @map("is_active")
  lastLogin     DateTime?     @map("last_login")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime?     @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  isSubAccount  Boolean?      @map("is_sub_account")
  updatedbBy    String?       @default("") @map("updated_by")
  transactions  Transaction[]
  userOutlets   UserOutlet[]
  userShift     UserShift[]

  @@map("users")
}

model Role {
  id          BigInt       @id @default(autoincrement())
  name        String
  storeId     BigInt?      @map("store_id")
  roles       Json?
  isActive    Boolean      @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  updatedBy   String?      @default("") @map("updated_by")
  userOutlets UserOutlet[]

  @@map("roles")
}

model Province {
  id        BigInt    @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  updatedBy String?   @default("") @map("updated_by")
  cities    City[]

  @@map("provinces")
}

model City {
  id         BigInt     @id @default(autoincrement())
  name       String
  provinceId BigInt     @map("province_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  updatedBy  String?    @default("") @map("updated_by")
  province   Province   @relation(fields: [provinceId], references: [id])
  districts  District[]

  @@index([provinceId], map: "cities_province_id_fkey")
  @@map("cities")
}

model District {
  id           BigInt        @id @default(autoincrement())
  name         String
  cityId       BigInt        @map("city_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  updatedBy    String?       @default("") @map("updated_by")
  city         City          @relation(fields: [cityId], references: [id])
  subdistricts Subdistrict[]

  @@index([cityId], map: "districts_city_id_fkey")
  @@map("districts")
}

model Subdistrict {
  id         BigInt    @id @default(autoincrement())
  name       String
  districtId BigInt    @map("distric_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  updatedBy  String?   @default("") @map("updated_by")
  district   District  @relation(fields: [districtId], references: [id])

  @@index([districtId], map: "subdistricts_distric_id_fkey")
  @@map("subdistricts")
}

model Store {
  id            BigInt         @id @default(autoincrement())
  userId        String         @unique @map("user_id")
  name          String
  slug          String         @unique
  subdistrictId BigInt?        @map("subdistrict_id")
  address       String
  address2      String?
  address3      String?
  phone         String
  isActive      Boolean        @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  updatedBy     String?        @default("") @map("updated_by")
  Outlets       Outlet[]
  productStocks ProductStock[]
  products      Product[]
  suppliers     Suplier[]

  @@map("stores")
}

model Brand {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?   @db.Text
  img         String?
  storeId     BigInt?   @map("store_id")
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  updatedBy   String?   @default("") @map("updated_by")
  products    Product[]

  @@map("brands")
}

model Category {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String?   @db.Text
  img         String?
  storeId     BigInt?   @map("store_id")
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  updatedBy   String?   @default("") @map("updated_by")
  products    Product[]

  @@map("categories")
}

model Product {
  id                   BigInt                @id @default(autoincrement())
  name                 String
  description          String?               @db.Text
  priceTagLabel        String?               @default("") @map("price_tag_label")
  img                  String?
  barcode              String?
  sku                  String?
  storeId              BigInt                @map("store_id")
  categoryId           BigInt                @map("category_id")
  brandId              BigInt                @map("brand_id")
  linkShopee           String?               @map("link_shopee")
  isActive             Boolean               @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime?             @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  updatedBy            String?               @default("") @map("updated_by")
  productType          String?               @default("PRODUCT") @map("product_type") @db.VarChar(100)
  stocks               ProductStock[]
  brand                Brand                 @relation(fields: [brandId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  store                Store                 @relation(fields: [storeId], references: [id])
  StockRequestProducts StockRequestProduct[]

  @@index([brandId], map: "products_brand_id_fkey")
  @@index([categoryId], map: "products_category_id_fkey")
  @@index([storeId], map: "products_store_id_fkey")
  @@map("products")
}

model Outlet {
  id               BigInt         @id @default(autoincrement())
  name             String
  sequence         Int?           @map("sequence")
  storeId          BigInt         @map("store_id")
  isActive         Boolean        @map("is_active")
  isActivePOS      Boolean?       @map("is_active_pos")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  updatedBy        String?        @default("") @map("updated_by")
  address          String?
  phone            String?
  printExtraInfo   String?        @map("printExtraInfo")
  printHeaderLine1 String?        @map("print_header_line1")
  printHeaderLine2 String?        @map("print_header_line2")
  printHeaderLine3 String?        @map("print_header_line3")
  printHeaderLine4 String?        @map("print_header_line4")
  printHeaderLogo  String?        @map("print_header_logo")
  printHeaderLine5 String?        @map("print_header_line5")
  discounts        Discount[]
  store            Store          @relation(fields: [storeId], references: [id])
  productStock     ProductStock[]
  shifts           Shift[]
  destOutlets      StockRequest[] @relation("destOutlet")
  reqOutlets       StockRequest[] @relation("reqOutlet")
  transactions     Transaction[]
  userOutlets      UserOutlet[]

  @@index([storeId], map: "outlets_store_id_fkey")
  @@map("outlets")
}

model Suplier {
  id        BigInt    @id @default(autoincrement())
  name      String
  address   String    @db.Text
  phone     String
  storeId   BigInt    @map("store_id")
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  updatedBy String?   @default("") @map("updated_by")
  store     Store     @relation(fields: [storeId], references: [id])

  @@index([storeId], map: "suppliers_store_id_fkey")
  @@map("suppliers")
}

model ProductStock {
  id                 BigInt          @id @default(autoincrement())
  productId          BigInt          @map("product_id")
  storeId            BigInt          @map("store_id")
  outletId           BigInt          @map("outlet_id")
  quantity           Int
  sellPrice          Decimal         @db.Decimal(10, 2)
  sellPriceGrosir    Decimal         @db.Decimal(10, 2)
  minGrosir          Int
  discountPercentage Int?            @map("discount_percentage")
  markupPercentage   Int?            @map("markup_percentage")
  isActive           Boolean         @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime?       @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  updatedBy          String?         @default("") @map("updated_by")
  cogs               Decimal         @default(0.00) @db.Decimal(10, 2)
  outlet             Outlet          @relation(fields: [outletId], references: [id])
  product            Product         @relation(fields: [productId], references: [id])
  store              Store           @relation(fields: [storeId], references: [id])
  stockMovements     StockMovement[]

  @@unique([storeId, productId, outletId])
  @@index([outletId], map: "product_stocks_outlet_id_fkey")
  @@index([productId], map: "product_stocks_product_id_fkey")
  @@map("product_stocks")
}

model MoveType {
  id             BigInt          @id @default(autoincrement())
  name           String
  direction      DirectionEnum   @map("direction")
  storeId        BigInt?         @map("store_id")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  updatedBy      String?         @default("") @map("updated_by")
  stockMovements StockMovement[]

  @@map("move_types")
}

model StockMovement {
  id             BigInt        @id @default(autoincrement())
  moveDate       DateTime      @map("move_date") @db.Date
  moveDateStr    String        @default("") @map("move_date_str")
  productStockId BigInt        @map("product_stock_id")
  startQuantity  Int?          @map("start_quantity")
  quantity       Int
  endQuantity    Int?          @map("end_quantity")
  direction      DirectionEnum @map("direction")
  moveTypeId     BigInt        @map("move_type_id")
  supplierId     BigInt?       @map("supplier_id")
  description    String?       @db.Text
  cogs           Decimal?      @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  updatedBy      String?       @default("") @map("updated_by")
  expiredDateStr String?       @default("") @map("expired_date_str")
  expiredDate    DateTime?     @map("expired_date")
  soldOut        Boolean?      @map("sold_out")
  moveType       MoveType      @relation(fields: [moveTypeId], references: [id])
  productStock   ProductStock  @relation(fields: [productStockId], references: [id])

  @@index([expiredDate, soldOut], map: "idx_expired_date_sold_out")
  @@index([moveTypeId], map: "stock_movements_move_type_id_fkey")
  @@index([productStockId], map: "stock_movements_product_stock_id_fkey")
  @@map("stock_movements")
}

model StockRequest {
  id                  BigInt                @id @default(autoincrement())
  requestTime         DateTime              @map("request_time")
  approvedTime        DateTime?             @map("approved_time")
  requestOutletId     BigInt                @map("request_outled_id")
  destinationOutletId BigInt                @map("destination_outled_id")
  isClosed            Boolean               @default(false) @map("is_closed")
  isApproved          Boolean               @default(false) @map("is_approved")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime?             @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  updatedBy           String?               @default("") @map("updated_by")
  products            StockRequestProduct[]
  destOutlet          Outlet                @relation("destOutlet", fields: [destinationOutletId], references: [id])
  reqOutlet           Outlet                @relation("reqOutlet", fields: [requestOutletId], references: [id])

  @@index([destinationOutletId], map: "stock_requests_destination_outled_id_fkey")
  @@index([requestOutletId], map: "stock_requests_request_outled_id_fkey")
  @@map("stock_requests")
}

model StockRequestProduct {
  id             BigInt       @id @default(autoincrement())
  stockRequestId BigInt
  productId      BigInt       @map("product_id")
  quantity       Int
  isApproved     Boolean      @map("is_approved")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  updatedBy      String?      @default("") @map("updated_by")
  product        Product      @relation(fields: [productId], references: [id])
  stockRequest   StockRequest @relation(fields: [stockRequestId], references: [id])

  @@index([productId], map: "stock_request_products_product_id_fkey")
  @@index([stockRequestId], map: "stock_request_products_stockRequestId_fkey")
  @@map("stock_request_products")
}

model PaymentMethod {
  id                   Int                   @id @default(autoincrement())
  name                 String
  displayName          String                @map("display_name")
  description          String?               @db.Text
  img                  String?
  isActive             Boolean               @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime?             @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  updatedBy            String?               @default("") @map("updated_by")
  OutletPaymentMethods OutletPaymentMethod[]

  @@map("payment_methods")
}

model OutletPaymentMethod {
  id              BigInt        @id @default(autoincrement())
  outletId        BigInt?       @map("outlet_id")
  storeId         BigInt?       @map("storeId")
  paymentMethodId Int           @map("payment_method_id")
  isActive        Boolean       @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  updatedBy       String?       @default("") @map("updated_by")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  transactions    Transaction[]

  @@unique([storeId, outletId, paymentMethodId])
  @@index([paymentMethodId], map: "outlet_payment_methods_payment_method_id_fkey")
  @@map("outlet_payment_methods")
}

model UserOutlet {
  id        BigInt    @id @default(autoincrement())
  userId    String
  outletId  BigInt    @map("outlet_id")
  roleId    BigInt    @map("role_id")
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  updatedBy String?   @default("") @map("updated_by")
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([outletId], map: "user_outlets_outlet_id_fkey")
  @@index([roleId], map: "user_outlets_role_id_fkey")
  @@index([userId], map: "user_outlets_userId_fkey")
  @@map("user_outlets")
}

model Shift {
  id           BigInt      @id @default(autoincrement())
  outletId     BigInt      @map("outlet_id")
  name         String
  sort         Int
  workingHours String?     @map("working_hours")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  updatedBy    String?     @default("") @map("updated_by")
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  userShifts   UserShift[]

  @@index([outletId], map: "shifts_outlet_id_fkey")
  @@map("shifts")
}

model UserShift {
  id            BigInt        @id @default(autoincrement())
  shiftId       BigInt        @map("shift_id")
  userId        String        @map("user_id")
  startDateTime DateTime      @map("start_date_time")
  endDateTime   DateTime?     @map("end_date_time")
  capital       Decimal?      @map("capital") @db.Decimal(10, 2)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime?     @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  updatedBy     String?       @default("") @map("updated_by")
  transactions  Transaction[]
  shift         Shift         @relation(fields: [shiftId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([shiftId], map: "user_shifts_shift_id_fkey")
  @@index([userId], map: "user_shifts_user_id_fkey")
  @@map("user_shifts")
}

model Transaction {
  id                    String               @id @db.VarChar(25)
  outletId              BigInt               @map("outlet_id")
  storeId               BigInt               @map("store_id")
  userId                String               @map("user_id")
  userShiftId           BigInt               @map("user_shift_id")
  totalItem             Int?                 @map("total_item")
  totalPrice            Decimal?             @map("total_price") @db.Decimal(10, 2)
  totalDiscount         Decimal?             @map("total_discount") @db.Decimal(10, 2)
  amountPaid            Decimal?             @map("amount_paid") @db.Decimal(10, 2)
  amountChange          Decimal?             @map("amount_change") @db.Decimal(10, 2)
  outletPaymentMethodId BigInt               @map("outlet_payment_method_id")
  cardNumber            String?              @map("card_number")
  confirmNumber         String?              @map("confirm_number")
  transactionTime       DateTime             @map("transaction_time")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime?            @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")
  updatedBy             String?              @default("") @map("updated_by")
  subTotal              Decimal?             @map("sub_total") @db.Decimal(10, 2)
  transactionDetails    TransactionDetail[]
  transactionDiscount   TransactionDiscount?
  outlet                Outlet               @relation(fields: [outletId], references: [id])
  outletPaymentMethod   OutletPaymentMethod  @relation(fields: [outletPaymentMethodId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id])
  userShift             UserShift            @relation(fields: [userShiftId], references: [id])

  @@index([outletId], map: "transactions_outlet_id_fkey")
  @@index([outletPaymentMethodId], map: "transactions_outlet_payment_method_id_fkey")
  @@index([userId], map: "transactions_user_id_fkey")
  @@index([userShiftId], map: "transactions_user_shift_id_fkey")
  @@map("transactions")
}

model TransactionDetail {
  id                 BigInt                              @id @default(autoincrement())
  transactionId      String                              @map("transaction_id")
  productId          BigInt                              @map("product_id")
  name               String
  barcode            String?
  categoryId         BigInt                              @map("category_id")
  brandId            BigInt                              @map("brand_id")
  detailCategory     transaction_details_detail_category @default(PRODUCT) @map("detail_category")
  qty                Int                                 @map("qty")
  sellPrice          Decimal                             @map("sell_price") @db.Decimal(10, 2)
  discountPercentage Int?                                @map("discount_percentage")
  markupPercentage   Int?                                @map("markup_percentage")
  discountAmount     Decimal                             @map("discount_amount") @db.Decimal(10, 2)
  finalSellPrice     Decimal                             @map("final_sell_price") @db.Decimal(10, 2)
  total              Decimal                             @map("total") @db.Decimal(10, 2)
  totalDiscount      Decimal                             @map("total_discount") @db.Decimal(10, 2)
  createdAt          DateTime                            @default(now()) @map("created_at")
  updatedAt          DateTime?                           @updatedAt @map("updated_at")
  deletedAt          DateTime?                           @map("deleted_at")
  updatedBy          String?                             @default("") @map("updated_by")
  productStockId     BigInt                              @map("product_stock_id")
  transaction        Transaction                         @relation(fields: [transactionId], references: [id])

  @@index([transactionId], map: "transaction_details_transaction_id_fkey")
  @@map("transaction_details")
}

model Device {
  id               String    @id @default(cuid())
  deviceId         String    @map("device_id")
  deviceNumber     Int       @map("device_number")
  manufacturer     String?   @map("manufacturer")
  brand            String?   @map("brand")
  modelId          String?   @map("modelId")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  updatedBy        String?   @default("") @map("updated_by")
  storeId          BigInt    @map("store_id")
  deviceName       String?   @map("device_name")
  deviceType       Int?      @map("device_type")
  osName           String?   @map("os_name")
  osVersion        String?   @map("os_version")
  platformApiLevel Int?      @map("platform_api_level")
  modelName        String?   @map("model_name")
  outletId         BigInt?   @map("outlet_id")

  @@map("devices")
}

model RequestEditTransaction {
  id            String    @id @default(cuid())
  transactionId String    @map("transaction_id")
  code          String    @map("code")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  updatedBy     String?   @default("") @map("updated_by")

  @@unique([transactionId, code])
  @@map("request_edit_transactions")
}

model TestTransaction {
  id            BigInt    @id @default(autoincrement())
  transactionId String    @map("transaction_id")
  data          String    @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  updatedBy     String?   @default("") @map("updated_by")
}

model Barcode {
  id        BigInt  @id @default(autoincrement())
  productId BigInt? @map("product_id")
  barcode   String? @db.VarChar(100)
  storeId   BigInt? @map("store_id")

  @@map("barcodes")
}

model Discount {
  id             BigInt                  @id @default(autoincrement())
  name           String                  @db.VarChar(100)
  discountType   discounts_discount_type @default(PERCENT) @map("discount_type")
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime?               @default(now()) @map("updated_at") @db.DateTime(0)
  deletedAt      DateTime?               @map("deleted_at") @db.DateTime(0)
  updatedBy      String?                 @map("updated_by") @db.VarChar(100)
  outletId       BigInt?                 @map("outlet_id")
  isActive       Boolean?                @default(true) @map("is_active")
  code           String?                 @map("code") @db.VarChar(100)
  minTransaction Decimal?                @map("min_transaction") @db.Decimal(10, 2)
  maxAmount      Decimal?                @map("max_amount") @db.Decimal(10, 2)
  createdBy      String?                 @map("created_by") @db.VarChar(100)
  discountValue  Decimal?                @default(0.00) @map("discount_value") @db.Decimal(10, 2)
  recommendation Boolean?                @default(true)
  startDate       DateTime?               @db.Date @map("start_date")
  quota          Int?
  endDate     DateTime?               @db.Date @map("end_date")
  outlets        Outlet?                 @relation(fields: [outletId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "discounts_outlets_FK")

  @@index([outletId], map: "discounts_outlets_FK")
  @@map("discounts")
}

model TransactionDiscount {
  id             BigInt      @id @default(autoincrement())
  transactionId  String      @unique @map("transaction_id") @db.VarChar(255)
  discountId     BigInt?     @map("discount_id")
  name           String?     @map("name") @db.VarChar(100)
  code           String?     @map("code") @db.VarChar(100)
  discountType   String?     @map("discount_type") @db.VarChar(100)
  discountValue  Decimal?    @map("discount_value") @db.Decimal(10, 2)
  minTransaction Decimal?    @map("min_transaction") @db.Decimal(10, 2)
  maxAmount      Decimal?    @map("max_amount") @db.Decimal(10, 2)
  isActive       Boolean?    @map("is_active")
  recommendation Boolean?
  transactions   Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transaction_discounts_transactions_FK")

  @@index([transactionId], map: "transaction_discounts_transactions_FK")
  @@map("transaction_discounts")
}

enum DirectionEnum {
  IN
  OUT
}

enum discounts_discount_type {
  PERCENT
  AMOUNT
}

enum transaction_details_detail_category {
  PRODUCT
  PRODUCT_UNCOUNT
  DISCOUNT
  DISCOUNT_VOUCHER
  DISCOUNT_ADDITIONAL
}
